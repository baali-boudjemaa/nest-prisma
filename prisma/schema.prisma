// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
  // Output to backend node_modules so packaged app has everything together
  output       = "../node_modules/.prisma/client"
  engineType   = "library"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserRole {
  ADMIN
  USER
}

enum Status {
  PRESENT
  ABSENT
  EXCUSED
}

// Models
model User {
  id        String   @id @default(uuid())
  name      String
  role      UserRole @default(USER)
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userProfile  UserProfile?
  createdLinks StudentGuardian[] @relation("UserCreatedLinks")
}

model UserProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  fullAddress String
  lastName    String
  firstName   String
  phoneNumber String?
  dateOfBirth String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Student {
  id             String    @id @default(uuid())
  firstName      String
  lastName       String
  dateOfBirth    DateTime
  gender         String?
  medicalInfo    String? // Allergies, conditions, etc.
  enrollmentDate DateTime  @default(now())
  payments       Payment[]

  classId String?
  class   Classroom? @relation(fields: [classId], references: [id])

  // 🔥 NEW: Student linked to a specific care session block
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])

  guardians  StudentGuardian[]
  attendance Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guardian {
  id          String  @id @default(uuid())
  firstName   String
  lastName    String
  phoneNumber String
  email       String  @unique
  address     String?

  students StudentGuardian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentGuardian {
  studentId    String
  guardianId   String
  relationship String // e.g., "Mother", "Father", "Grandparent"
  isEmergency  Boolean @default(false)
  createdById  String

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian  Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  createdBy User     @relation("UserCreatedLinks", fields: [createdById], references: [id])

  @@id([studentId, guardianId])
}

model Teacher {
  id             String  @id @default(uuid())
  firstName      String
  lastName       String
  phoneNumber    String
  email          String  @unique
  certifications String? // e.g., "CPR, ECE"

  classes Classroom[]
  seances Seance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Classroom {
  id          String  @id @default(uuid())
  name        String // e.g., "Little Caterpillars"
  ageGroup    String? // e.g., "3-4 years"
  roomNumber  String?
  maxCapacity Int?

  leadTeacherId String?
  leadTeacher   Teacher?  @relation(fields: [leadTeacherId], references: [id])
  students      Student[]
  seances       Seance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SessionName {
  Matinée
  Journée_Complète
  Périscolaire
}

// 🟢 NEW MODEL: Broad daycare care blocks (e.g., "Morning only")
model Session {
  id          String      @id @default(uuid())
  sessionname SessionName
  name        String // e.g., "Matinée", "Journée Complète", "Périscolaire"
  startTime   String // e.g., "07:30"
  endTime     String // e.g., "12:30"

  // To evaluate revenue or calculate billing by plan
  basePrice Decimal? @db.Decimal(10, 2)

  students Student[] // Children enrolled specifically in this recurring timeframe

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Fixed timeframe hourly events or subjects inside the classroom
model Seance {
  id        String @id @default(uuid())
  subject   String // e.g., "Sieste", "Painting"
  dayOfWeek String // e.g., "Monday", "Tuesday"
  startTime String // e.g., "09:00"
  endTime   String // e.g., "10:30"

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  attendance Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seance")
}

model Attendance {
  id           String    @id @default(uuid())
  date         DateTime  @default(now())
  status       Status    @default(PRESENT)
  checkInTime  DateTime?
  checkOutTime DateTime?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  seanceId String?
  seance   Seance? @relation(fields: [seanceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date, seanceId])
}

model Payment {
  id          String @id @default(uuid())
  paymentType String
  monthPaid   String

  amount      Decimal  @db.Decimal(10, 2)
  paymentDate DateTime @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id          String   @id @default(uuid())
  title       String // e.g., "Art Supplies", "Electricity Bill"
  category    String // e.g., "Utilities", "Salaries", "Supplies"
  amount      Decimal  @db.Decimal(10, 2)
  expenseDate DateTime @default(now())

  description String? // Optional details

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("expenses")
}

// 🍎 1. Catalogue des ingrédients et état des stocks
model Ingredient {
  id             String  @id @default(uuid())
  name           String  @unique // ex: "Lait", "Pommes de terre"
  category       String // ex: "Produits laitiers", "Légumes"
  currentStock   Decimal @default(0) @db.Decimal(10, 2)
  unit           String // ex: "kg", "litres", "pièces"
  alertThreshold Decimal @default(5) @db.Decimal(10, 2) // Seuil d'alerte pour rachat

  needs         KitchenNeed[]
  purchaseItems PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ingredients")
}

// 📝 2. Liste des besoins en cuisine pour préparer les repas
model KitchenNeed {
  id             String     @id @default(uuid())
  quantityNeeded Decimal    @db.Decimal(10, 2)
  status         NeedStatus @default(PENDING) // En attente, Acheté

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kitchen_needs")
}

enum NeedStatus {
  PENDING
  PURCHASED
}

model KitchenPurchase {
  id           String   @id @default(uuid())
  supplier     String? // Nom du magasin ou fournisseur
  purchaseDate DateTime @default(now())
  paymentType  String // "Cash", "Card", "Transfer"
  totalAmount  Decimal  @db.Decimal(10, 2) // Montant total de la facture

  items PurchaseItem[] // Détails des articles sur le ticket

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kitchen_purchases")
}

model PurchaseItem {
  id        String  @id @default(uuid())
  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(10, 2) // Prix unitaire lors de cet achat

  purchaseId String
  purchase   KitchenPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("purchase_items")
}
