// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
  // Output to backend node_modules so packaged app has everything together
  output       = "../node_modules/.prisma/client"
  engineType   = "library"
}

datasource db {
  provider = "postgresql"
}
// =======================
// ENUMS
// =======================

enum UserRole {
  ADMIN
  USER
}

enum Status {
  PRESENT
  ABSENT
  EXCUSED
}

enum Gender {
  MALE
  FEMALE
}

enum EmployeeRole {
  TEACHER
  ASSISTANT
  KITCHEN
  CLEANER
  ADMIN
}

enum PaymentType {
  CASH
  CARD
  TRANSFER
}

enum ExpenseCategory {
  SALARY
  UTILITIES
  FOOD
  SUPPLIES
  MAINTENANCE
  OTHER
}

enum SessionName {
  Matinee
  JourneeComplete
  Periscolaire
}

enum NeedStatus {
  PENDING
  PURCHASED
}

// =======================
// EMPLOYEE
// Replaces Teacher
// =======================

model Employee {
  id             String @id @default(uuid())
  employeeNumber String @unique

  firstName      String
  lastName       String
  phoneNumber    String
  email          String @unique

  role           EmployeeRole
  certifications String?

  classrooms Classroom[]
  seances    Seance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// STUDENT
// =======================

model Student {
  id            String @id @default(uuid())
  studentNumber String @unique

  firstName      String
  lastName       String
  dateOfBirth    DateTime
  gender         Gender?
  medicalInfo    String?
  enrollmentDate DateTime @default(now())

  classId String?
  class   Classroom? @relation(fields: [classId], references: [id])

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])

  guardians  StudentGuardian[]
  attendance Attendance[]
  payments   Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@index([sessionId])
}

// =======================
// GUARDIAN
// =======================

model Guardian {
  id             String @id @default(uuid())
  guardianNumber String @unique

  firstName   String
  lastName    String
  phoneNumber String
  email       String @unique
  address     String?

  students StudentGuardian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// CLASSROOM
// =======================

model Classroom {
  id          String @id @default(uuid())
  classNumber String @unique

  name        String
  ageGroup    String?
  roomNumber  String?
  maxCapacity Int?

  supervisorId String?
  supervisor   Employee? @relation(fields: [supervisorId], references: [id])

  students Student[]
  seances  Seance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// SESSION
// =======================

model Session {
  id String @id @default(uuid())

  name SessionName

  startTime String
  endTime   String

  maxStudents Int?

  basePrice Float?

  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// SEANCE
// =======================

model Seance {
  id String @id @default(uuid())

  subject   String
  dayOfWeek String
  startTime String
  endTime   String

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  attendance Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seance")
}

// =======================
// ATTENDANCE
// =======================

model Attendance {
  id String @id @default(uuid())

  date         DateTime @default(now())
  status       Status @default(PRESENT)
  checkInTime  DateTime?
  checkOutTime DateTime?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  seanceId String?
  seance   Seance? @relation(fields: [seanceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date, seanceId])
  @@index([studentId])
  @@index([date])
}

// =======================
// PAYMENT
// =======================

model Payment {
  id String @id @default(uuid())

  paymentType PaymentType

  billingMonth DateTime

  amount Float

  paymentDate DateTime @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([billingMonth])
}

// =======================
// EXPENSE
// =======================

model Expense {
  id String @id @default(uuid())

  title String

  category ExpenseCategory

  amount Float

  expenseDate DateTime @default(now())

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("expenses")
}
model StudentGuardian {
  studentId    String
  guardianId   String
  relationship String // e.g., "Mother", "Father", "Grandparent"
  isEmergency  Boolean @default(false)
  createdById  String

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian  Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  createdBy User     @relation("UserCreatedLinks", fields: [createdById], references: [id])

  @@id([studentId, guardianId])
}
model User {
  id        String   @id @default(uuid())
  name      String
  role      UserRole @default(USER)
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userProfile  UserProfile?
  createdLinks StudentGuardian[] @relation("UserCreatedLinks")
}
model UserProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  fullAddress String
  lastName    String
  firstName   String
  phoneNumber String?
  dateOfBirth String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}