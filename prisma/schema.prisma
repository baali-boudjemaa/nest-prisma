generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

model user {
  id        String   @id @default(uuid())
  role      UserRole @default(USER)
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  userProfiles userProfile[]
}

model userProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  fullAddress String
  lastName    String
  firstName   String
  phoneNumber String?
  dateOfBirth String?
  user        user    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
