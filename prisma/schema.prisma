// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
  // Output to backend node_modules so packaged app has everything together
  output       = "../node_modules/.prisma/client"
  engineType   = "library"
}

datasource db {
  provider = "postgresql"
}

// =======================
// ENUMS
// =======================



// =======================
// ENUMS
// =======================

enum Sexe {
  MALE
  FEMALE
}

enum EmployeeRole {
  TEACHER
  ASSISTANT
  KITCHEN
  CLEANER
  ADMIN
}

enum PaymentType {
  CASH
  CARD
  TRANSFER
}

enum SessionName {
  MATINEE
  JOURNEE_COMPLETE
  PERISCOLAIRE
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  ACQUIRED
}

enum LogType {
  MEAL
  NAP
  BATHROOM
  MEDICATION
  BEHAVIOR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum ExpenseCategory {
  SALARY
  FOOD
  UTILITIES
  SUPPLIES
  MAINTENANCE
  OTHER
}

enum NeedStatus {
  PENDING
  PURCHASED
}

// =======================
// STAFF
// =======================

model Employee {
  id             String       @id @default(uuid())
  employeeNumber String       @unique
  firstName      String
  lastName       String
  phoneNumber    String
  email          String       @unique
  role           EmployeeRole @default(TEACHER)
  certifications String?

  classrooms EmployeeClassroom[]
  dailyLogs  DailyLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

// =======================
// STUDENTS
// =======================

model Student {
  id            String @id @default(uuid())
  studentNumber String @unique

  firstName      String
  lastName       String
  dateOfBirth    DateTime
  gender         Sexe?
  medicalInfo    String?
  enrollmentDate DateTime @default(now())

  guardians    StudentGuardian[]
  inscriptions Inscription[]
  absences     Absence[]
  attendance   Attendance[]
  dailyLogs    DailyLog[]
  milestones   StudentMilestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// GUARDIANS
// =======================

model Guardian {
  id          String  @id @default(uuid())
  firstName   String
  lastName    String
  phoneNumber String
  email       String  @unique
  relation    String
  address     String?

  students StudentGuardian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentGuardian {
  id         String @id @default(uuid())
  studentId  String
  guardianId String

  isEmergencyContact   Boolean @default(false)
  isAuthorizedToPickUp Boolean @default(true)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
}

// =======================
// ACADEMIC
// =======================

model AnneeScolaire {
  id             String @id @default(uuid())
  libelleAnneesc String @unique

  inscriptions Inscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Classroom {
  id       String  @id @default(uuid())
  name     String
  ageGroup String?
  capacity Int

  inscriptions Inscription[]
  employees    EmployeeClassroom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeClassroom {
  id         String  @id @default(uuid())
  employeeId String
  classId    String
  isLead     Boolean @default(false)

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([employeeId, classId])
}

model Inscription {
  id String @id @default(uuid())

  studentId       String
  anneeScolaireId String
  classId         String

  session SessionName @default(JOURNEE_COMPLETE)

  dateInscription DateTime @default(now())

  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)
  classroom     Classroom     @relation(fields: [classId], references: [id], onDelete: Cascade)

  payments Payment[]
}

// =======================
// ATTENDANCE
// =======================

model Attendance {
  id String @id @default(uuid())

  studentId String
  date      DateTime

  status AttendanceStatus @default(PRESENT)

  checkInTime  DateTime?
  checkOutTime DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
}

model Absence {
  id        String @id @default(uuid())
  studentId String

  dateAbsc DateTime
  motif    String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// =======================
// DAILY LOGS
// =======================

model DailyLog {
  id String @id @default(uuid())

  studentId  String
  employeeId String

  type      LogType
  timestamp DateTime @default(now())

  notes String

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// =======================
// MILESTONES
// =======================

model Milestone {
  id          String @id @default(uuid())
  category    String
  description String

  students StudentMilestone[]
}

model StudentMilestone {
  id String @id @default(uuid())

  studentId   String
  milestoneId String

  status MilestoneStatus @default(NOT_STARTED)

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([studentId, milestoneId])
}

// =======================
// FINANCE
// =======================

model SessionPricing {
  id String @id @default(uuid())

  session    SessionName @unique
  monthlyFee Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id String @id @default(uuid())

  inscriptionId String

  amount        Float
  paymentMethod PaymentType @default(CASH)

  datePay DateTime @default(now())
  label   String

  inscription Inscription @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id String @id @default(uuid())

  title    String
  category ExpenseCategory

  amount Float

  expenseDate DateTime @default(now())

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// KITCHEN INVENTORY
// =======================

model Ingredient {
  id String @id @default(uuid())

  name     String @unique
  category String

  currentStock Float  @default(0)
  unit         String

  alertThreshold Float @default(5)

  needs         KitchenNeed[]
  purchaseItems PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KitchenNeed {
  id String @id @default(uuid())

  quantityNeeded Float

  status NeedStatus @default(PENDING)

  ingredientId String

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KitchenPurchase {
  id String @id @default(uuid())

  supplier     String?
  purchaseDate DateTime @default(now())

  paymentType PaymentType
  totalAmount Float

  items PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseItem {
  id String @id @default(uuid())

  quantity  Float
  unitPrice Float

  purchaseId String
  purchase   KitchenPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String

  role      UserRole @default(TEACHER)

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userProfiles UserProfile[]
}

model UserProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  fullAddress String
  lastName    String
  firstName   String
  phoneNumber String?
  dateOfBirth String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
enum UserRole {
  ADMIN
  TEACHER
  ASSISTANT
  KITCHEN
  CLEANER
}